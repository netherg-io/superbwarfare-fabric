{
  "schemaVersion": 1,
  "id": "superbwarfare",
  "version": "${version}",
  "name": "Superb Warfare",
  "description": "A Warfare Mod — Fabric port for Blockfield",
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.atsuishio.superbwarfare.Mod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.atsuishio.superbwarfare.ModClient"
      }
    ]
  },
  "mixins": [
    "mixins.superbwarfare.json"
  ],
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "forgeconfigapiport": "*",
    "accessories": "*",
    "geckolib": "*",
    "simplebedrockmodel": "*",
    "porting_lib_core": "*",
    "porting_lib_entity": "*",
    "porting_lib_items": "*",
    "porting_lib_level_events": "*",
    "porting_lib_client_events": "*",
    "porting_lib_transfer": "*"
  }
}
